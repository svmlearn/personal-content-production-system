{
  "name": "personal-site-monorepo",
  "private": true,
  "scripts": {
    "dev:portfolio": "python3 -m http.server 8080 -d apps/portfolio",
    "dev:content-growth": "pnpm --dir apps/content-growth-platform dev --port 3001",
    "dev:ai-learning": "pnpm --dir apps/ai-learning-companion dev --port 3003",
    "dev:fde": "pnpm --dir apps/fde-ai-empowerment dev --port 3004",
    "lint:content-growth": "pnpm --dir apps/content-growth-platform lint",
    "lint:ai-learning": "pnpm --dir apps/ai-learning-companion lint",
    "lint:fde": "pnpm --dir apps/fde-ai-empowerment lint",
    "typecheck:content-growth": "pnpm --dir apps/content-growth-platform typecheck",
    "build:content-growth": "pnpm --dir apps/content-growth-platform build",
    "build:ai-learning": "pnpm --dir apps/ai-learning-companion build",
    "build:fde": "pnpm --dir apps/fde-ai-empowerment build"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "qs": "6.15.2"
    }
  }
}
